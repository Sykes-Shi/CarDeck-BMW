<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/deckRipple">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="?attr/deckRaised" android:endColor="?attr/deckControl" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="?attr/deckOutline" />
        </shape>
    </item>
</ripple>
