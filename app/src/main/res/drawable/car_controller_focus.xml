<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The dark keyline remains visible on pale album covers or wallpaper. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="5dp" android:color="@color/car_on_accent" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="3dp" android:color="@color/car_focus" />
        </shape>
    </item>
</layer-list>
